# ...but keep the dependency list tracked.
!07_reconstruction/requirements.txt

# Slurm job-submission folders (per-run worker scripts, work queues, job-id records)
**/slurm/

# Cloned reference implementations (RND paper repo, CleanRL, ExPLORe) — large, not tracked
reference_repos/
# The ExPLORe clone that used to sit at the repo root was deleted 2026-07-22; the one kept copy is
# /p/rlprojects/RLforOR/accelerating_exploration_with_unlabeled_prior_data/explore. This keeps a
# future re-clone here out of git (the existing "explore/" line above only covers the lowercase name).
/ExPLORe/

# Optuna controller state inside a run folder (journal log, per-trial decisions, SWEEP_COMPLETE
# sentinel) — regenerable run state, same treatment as the slurm/ and queue/ folders. The tutorial
# folder 07_reconstruction/optuna/ is NOT covered by this and stays tracked.
07_reconstruction/train_runs/**/optuna/

# Work-queue folders inside a run folder (pending/running/done/failed job configs)
07_reconstruction/train_runs/**/queue/

# jaguar03 threading experiment (inside the run-5 folder): measurement outputs, regenerable by
# re-running the experiment scripts. avxburn_work/ holds one .w text file per hardware thread
# (time + throughput lines); load_sweep_work/ holds per-worker .txt outputs; the data*/ folders
# hold the collected sweep measurements. The code files next to them (run_experiment.py,
# load_sweep.py, avxburn.c, jaguar03_throttle_repro.sh, report.md) stay tracked.
07_reconstruction/train_runs/**/jaguar03_threading_experiment/avxburn_work/
07_reconstruction/train_runs/**/jaguar03_threading_experiment/load_sweep_work/
07_reconstruction/train_runs/**/jaguar03_threading_experiment/data_*/

# Lock files written next to the collaborator job-id files while a worker appends to them
*.lock

# Optuna / sqlite storage backends
*.db
*.sqlite
*.sqlite3

# Monitoring snapshots inside a run folder (per-tick table dumps; the scripts themselves stay tracked)
07_reconstruction/train_runs/**/20_mins_monitoring/outputs/
