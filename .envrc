# Auto-activate conda environment using direnv
# Install direnv: conda install -c conda-forge direnv
# Then run: direnv allow

# Get conda base directory
CONDA_BASE=$(conda info --base 2>/dev/null)

if [ -n "$CONDA_BASE" ]; then
    # Source conda.sh to make conda available
    source "${CONDA_BASE}/etc/profile.d/conda.sh"
    
    # Activate explore environment
    conda activate explore
fi
