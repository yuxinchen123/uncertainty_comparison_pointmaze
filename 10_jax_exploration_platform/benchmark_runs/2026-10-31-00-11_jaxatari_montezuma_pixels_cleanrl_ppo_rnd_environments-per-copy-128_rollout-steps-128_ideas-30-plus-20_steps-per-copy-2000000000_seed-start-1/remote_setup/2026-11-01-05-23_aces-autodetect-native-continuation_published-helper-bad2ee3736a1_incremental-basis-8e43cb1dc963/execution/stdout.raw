/remote_setup/2026-11-01-02-22_aces-full-site_h100_driver-580.178.04_policies-1_environments-128_rollout-steps-128_epochs-4_minibatches-4_warmup-rollouts-50_reference-updates-1_seed-1_gpu-count-1_processor-count-8_host-memory-gib-32_time-limit-hours-3_torch-2.6.0-cpu/site_validation_plan.json', 'sha256': 'ec4c9aaee1123672c20e9ed56d9141799654fc2b0e7702f2cdfedde87fbf0a1a'}\nEXPECTED_OLD_SOFTWARE = {'path': '/scratch/user/u.sl359075/rnd_atari_pixels/runs/2026-10-31-00-11_jaxatari_montezuma_pixels_cleanrl_ppo_rnd_environments-per-copy-128_rollout-steps-128_ideas-30-plus-20_steps-per-copy-2000000000_seed-start-1/remote_setup/2026-11-01-02-22_aces-full-site_h100_driver-580.178.04_policies-1_environments-128_rollout-steps-128_epochs-4_minibatches-4_warmup-rollouts-50_reference-updates-1_seed-1_gpu-count-1_processor-count-8_host-memory-gib-32_time-limit-hours-3_torch-2.6.0-cpu/software_at_prepare.json', 'sha256': '889d77cae78088cf5e9aaf05776c8dad8fbbde95eef0c02254bfa4e9900ec8c7'}\nPROFILE_NAME = 'aces-h100-pcie-driver-580.178.04-autodetect-nvml-configured-isolation'\n\nimport hashlib\nimport importlib.util\nimport json\nimport os\nfrom pathlib import Path\nimport pwd\nimport socket\nimport subprocess\nimport sys\n\n\ndef require(value, message):\n    \"\"\"Reject changed native metadata without running numerical packages or submitting jobs.\"\"\"\n    if not value:\n        raise ValueError(message)\n\n\ndef exact(record):\n    \"\"\"Read only the preserved exact ordinary path and bound bytes.\"\"\"\n    path = Path(record['path'])\n    require(path.is_absolute() and path.resolve(strict=True) == path and path.is_file(), 'ordinary exact native file required')\n    content = path.read_bytes()\n    require(hashlib.sha256(content).hexdigest() == record['sha256'], 'preserved native file changed: ' + str(path))\n    return json.loads(content)\n\n\ndef query(arguments, accepted=(0,)):\n    \"\"\"Perform only bounded read-only local Git metadata checks.\"\"\"\n    value = subprocess.run(arguments, capture_output=True, text=True, timeout=120)\n    require(value.returncode in accepted, 'Git metadata failed: ' + repr(arguments))\n    return value\n\n\ndef verify():\n    \"\"\"Require the fresh packet to preserve the complete old software, source, assets and original admission.\"\"\"\n    require(str(Path(sys.executable).absolute()) == PRIVATE_PYTHON and sys.dont_write_bytecode,\n        'the selected private Python with bytecode disabled is required')\n    require(os.getuid() == 56626 and pwd.getpwuid(os.getuid()).pw_name == 'u.sl359075'\n        and socket.gethostname().split('.')[0] == 'alogin1', 'this metadata preparation is restricted to the existing ACES login owner')\n    forbidden = ('jax', 'jaxlib', 'numpy', 'torch', 'flax', 'optax', 'jaxtari', 'exploration_platform')\n    require(not any(name.split('.')[0] in forbidden for name in sys.modules), 'numerical package already loaded')\n    root = Path(HELPER_ROOT)\n    require(root.resolve(strict=True) == root, 'ordinary exact fresh helper checkout required')\n    require(query(['git', '-C', str(root), 'rev-parse', 'HEAD']).stdout.strip() == TIP\n        and query(['git', '-C', str(root), 'rev-parse', 'HEAD^{tree}']).stdout.strip() == TREE\n        and query(['git', '-C', str(root), 'symbolic-ref', '--quiet', 'HEAD'], (0, 1)).returncode == 1\n        and query(['git', '-C', str(root), 'status', '--porcelain', '--untracked-files=all']).stdout == '',\n        'the new helper checkout must be exact, detached and clean')\n    for relative, expected in EXPECTED_HELPERS.items():\n        path = root / relative\n        require(path.resolve(strict=True) == path and hashlib.sha256(path.read_bytes()).hexdigest() == expected,\n            'one committed helper changed: ' + relative)\n    entrypoint = root / '10_jax_exploration_platform/scripts/atari_pixel_campaign/aces_slurm_site_validation.py'\n    specification = importlib.util.spec_from_file_location('native_autodetect_metadata_verification', entrypoint)\n    module = importlib.util.module_from_spec(specification)\n    specification.loader.exec_module(module)\n    directory, unit, current = module.prepared(Path(PACKET))\n    previous, software = exact(EXPECTED_OLD_PLAN), exact(EXPECTED_OLD_SOFTWARE)\n    for key in ('python', 'numerical_source', 'cleanrl_reference', 'portable_admission', 'asset_record',\n            'jaxtari_source_root', 'admission', 'configuration', 'runtime_environment', 'gate_environment_policy',\n            'job_shape', 'reference_updates', 'child_order'):\n        require(current[key] == previous[key], 'new packet changed a reused original input: ' + key)\n    require(current['qualification_profile']['name'] == PROFILE_NAME\n        and current['qualification_profile']['physical_gres_mapping_verified'] is False\n        and current['qualification_profile']['kernel_device_enforcement_verified'] is False\n        and current['helpers']['source_commit'] == TIP and current['helpers']['files'] == EXPECTED_HELPERS,\n        'the distinct declared profile and exact eighteen-helper closure are required')\n    require(module.checked_software(current) == software\n        and software['installed_backend']['packages']['torch'] == '2.6.0+cpu'\n        and software['asset_receipt']['file_count'] == 4531, 'actual unchanged private software or exact asset view differs')\n    for name in ('experiment_background.md', 'manifest.yaml', 'config_resolved.yaml', 'command.txt'):\n        require((directory / name).read_bytes() == (unit / name).read_bytes(), 'initial standard data record changed')\n    require(not any(name.split('.')[0] in forbidden for name in sys.modules), 'metadata verification imported numerical code')\n    return {'schema_version': 1, 'kind': 'aces_autodetect_native_preparation_metadata_verification', 'passed': True,\n        'private_python': PRIVATE_PYTHON, 'packet': str(directory), 'data_unit': str(unit),\n        'profile_name': PROFILE_NAME, 'helper_commit': TIP, 'helper_count': len(EXPECTED_HELPERS),\n        'software_at_prepare': module.receipt(directory / 'software_at_prepare.json'),\n        'original_admission_preserved': True, 'asset_file_count': 4531, 'numerical_imports': [],\n        'actual_site_success': False, 'workers_permitted': False, 'scientific_hypothesis_credit': 0,\n        'comparison_credit': 0, 'idea_credit': 0, 'admission_credit': 0}\n\n\nif __name__ == '__main__':\n    print(json.dumps(verify(), indent=2, allow_nan=False))\n"
