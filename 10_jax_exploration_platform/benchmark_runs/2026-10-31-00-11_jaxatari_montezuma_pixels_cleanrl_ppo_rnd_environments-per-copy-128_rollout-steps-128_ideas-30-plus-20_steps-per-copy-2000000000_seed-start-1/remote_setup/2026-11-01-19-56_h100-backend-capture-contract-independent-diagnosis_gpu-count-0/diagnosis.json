  "producer_filter_source": {
    "actual_gpu_library_receipt": "def actual_gpu_library_receipt(backend, expected):\n    \"\"\"Query already loaded libraries and verify their actual bytes against checkpoint identity.\"\"\"\n    specification = importlib.util.spec_from_file_location('optimized_training_gpu_libraries', SCRIPT_ROOT / 'diagnose_gpu_execution.py')\n    helper = importlib.util.module_from_spec(specification)\n    specification.loader.exec_module(helper)\n    receipt = helper.loaded_gpu_libraries(backend)\n    loaded = {str(Path(path).resolve(strict=True)) for path in receipt['loaded_shared_libraries'] if Path(path).name.startswith(('libcudnn', 'libcudart'))}\n    verified = {}\n    for path in loaded:\n        if path not in expected or file_sha256(Path(path)) != expected[path]['sha256']:\n            raise ValueError('the actually loaded GPU library differs from the installed immutable image: ' + path)\n        verified[path] = expected[path]\n    return {**receipt, 'verified_package_libraries': verified, 'pid': os.getpid(), 'time': utc_now()}",
    "installed_gpu_library_receipts": "def installed_gpu_library_receipts():\n    \"\"\"Hash the installed cuDNN and CUDA runtime images before any training update.\"\"\"\n    files = {}\n    for name in ('nvidia-cudnn-cu12', 'nvidia-cuda-runtime-cu12'):\n        distribution = metadata.distribution(name)\n        for relative in distribution.files or []:\n            basename = Path(relative).name\n            if basename.startswith(('libcudnn', 'libcudart')) and '.so' in basename:\n                path = Path(distribution.locate_file(relative)).resolve(strict=True)\n                files[str(path)] = {'package': name, 'version': distribution.version, 'sha256': file_sha256(path)}\n    if not any((Path(path).name.startswith('libcudnn.so') for path in files)) or not any((Path(path).name.startswith('libcudart.so') for path in files)):\n        raise ValueError('the installed environment lacks its cuDNN/CUDA runtime images')\n    return files",
    "loaded_gpu_libraries": "def loaded_gpu_libraries(backend):\n    \"\"\"Record the backend and query versions from the CUDA libraries actually loaded after compilation.\"\"\"\n    paths = sorted({line.rsplit(None, 1)[-1] for line in Path('/proc/self/maps').read_text().splitlines() if '/' in line and any((name in line for name in ('libcudnn', 'libcudart', 'libcuda.so')))})\n    cudnn_paths = [path for path in paths if re.fullmatch('libcudnn\\\\.so(?:\\\\.\\\\d+)*', Path(path).name)]\n    runtime_paths = [path for path in paths if re.fullmatch('libcudart\\\\.so(?:\\\\.\\\\d+)*', Path(path).name)]\n    if len(cudnn_paths) != 1 or len(runtime_paths) != 1:\n        raise ValueError('the compiled process must identify one loaded cuDNN library and CUDA runtime')\n    cudnn = ctypes.CDLL(cudnn_paths[0], mode=os.RTLD_NOLOAD | os.RTLD_LOCAL)\n    cudnn.cudnnGetVersion.argtypes = []\n    cudnn.cudnnGetVersion.restype = ctypes.c_size_t\n    runtime = ctypes.CDLL(runtime_paths[0], mode=os.RTLD_NOLOAD | os.RTLD_LOCAL)\n    runtime.cudaRuntimeGetVersion.argtypes = [ctypes.POINTER(ctypes.c_int)]\n    runtime.cudaRuntimeGetVersion.restype = ctypes.c_int\n    cuda_version = ctypes.c_int()\n    cuda_status = runtime.cudaRuntimeGetVersion(ctypes.byref(cuda_version))\n    if cuda_status != 0:\n        raise RuntimeError(f'cudaRuntimeGetVersion failed with status {cuda_status}')\n    return {'platform': backend.platform, 'platform_version': backend.platform_version, 'loaded_shared_libraries': paths, 'cudnn_library': cudnn_paths[0], 'cudnnGetVersion': cudnn.cudnnGetVersion(), 'cuda_runtime_library': runtime_paths[0], 'cudaRuntimeGetVersion': cuda_version.value}"
  },
